    "issues": {
        "unknown_bands": {
            "title": "New tariff bands for {name}",
            "fix_flow": {
                "step": {
                    "confirm": {
                        "title": "Add the tariff bands",
                        "description": "ecojoko reports bands of your contract without a sensor yet: {bands}. This happens after a change of contract.\n\nSubmit creates their sensors, with their ecojoko name and the HC or HP total deduced from it. You can then rename them and change their total in the options of the integration."
                    }
                }
            }
        }
    },
    "services": {
        "get_savings": {
            "name": "Get savings",
            "description": "Returns the savings of a week, a month or a year, detailed by day, week or month, as the \"Savings in detail\" page of ecojoko.",
            "fields": {
                "config_entry_id": {
                    "name": "Installation",
                    "description": "Little Monkey installation; optional when there is only one."
                },
                "period": {
                    "name": "Period",
                    "description": "Week, month or year."
                },
                "date": {
                    "name": "Date",
                    "description": "A day of the period; today by default."
                }
            }
        },
        "get_consumption_analysis": {
            "name": "Get consumption analysis",
            "description": "Returns the breakdown of the consumption of a week or a month by category (standby, lighting, cooling…), as the “Analysis of your consumption” page of ecojoko.",
            "fields": {
                "config_entry_id": {
                    "name": "Installation",
                    "description": "Little Monkey installation; optional when there is only one."
                },
                "period": {
                    "name": "Period",
                    "description": "Week or month: ecojoko does not analyse years."
                },
                "date": {
                    "name": "Date",
                    "description": "A day of the period; by default, the last period analysed by ecojoko."
                }
            }
        },
        "get_category_history": {
            "name": "Get category history",
            "description": "Returns the consumption of a category week by week over a year.",
            "fields": {
                "config_entry_id": {
                    "name": "Installation",
                    "description": "Little Monkey installation; optional when there is only one."
                },
                "category": {
                    "name": "Category",
                    "description": "Identifier of the category, given by the consumption analysis."
                },
                "date": {
                    "name": "Date",
                    "description": "A day of the year; today by default."
                }
            }
        },
        "get_activations": {
            "name": "Get appliance activations",
            "description": "Returns the appliance starts detected by ecojoko over 48 hours.",
            "fields": {
                "config_entry_id": {
                    "name": "Installation",
                    "description": "Little Monkey installation; optional when there is only one."
                },
                "page": {
                    "name": "Page",
                    "description": "0 for the last 48 hours, 1 for the 48 hours before, and so on."
                }
            }
        },
        "get_equipments": {
            "name": "Read the equipments",
            "description": "Returns the equipments of the installation, their state and, for the piloted ones, their measures of the day.",
            "fields": {
                "config_entry_id": {
                    "name": "Installation",
                    "description": "Little Monkey installation; optional when there is only one."
                }
            }
        },
        "set_equipment_mode": {
            "name": "Control an equipment",
            "description": "Forces an equipment piloted by ecojoko, turns it off for an absence, sets it back to automatic, or turns it on and off when it has no forced mode.",
            "fields": {
                "device_id": {
                    "name": "Equipment",
                    "description": "The device of the piloted equipment."
                },
                "mode": {
                    "name": "Mode",
                    "description": "Automatic, Forced, Absence, or Turn on and Turn off for an equipment without a forced mode."
                },
                "duration": {
                    "name": "Duration",
                    "description": "Duration of the forced mode (1 hour by default) or of the absence, in minutes."
                },
                "until": {
                    "name": "End of the absence",
                    "description": "Date and time the absence ends, instead of the duration."
                }
            }
        },
        "get_measures": {
            "name": "Get measures",
            "description": "Returns the measures of a period, as the “Measures” page of ecojoko: the power of a day or the energy and cost of the days or months by tariff band, the temperature or humidity inside and outside.",
            "fields": {
                "config_entry_id": {
                    "name": "Installation",
                    "description": "Little Monkey installation; optional when there is only one."
                },
                "measure": {
                    "name": "Measure",
                    "description": "Electricity, temperature or humidity."
                },
                "period": {
                    "name": "Period",
                    "description": "Day, week, month or year."
                },
                "date": {
                    "name": "Date",
                    "description": "A day of the period; today by default. For the electricity, the month is the 30 days ending that day; for the temperature and humidity, the calendar month."
                },
                "check": {
                    "name": "Check the option",
                    "description": "Only tells whether the “Measures” option is on, without reading ecojoko."
                }
            }
        }
    },
    "exceptions": {
        "entry_not_found": {
            "message": "No loaded Little Monkey installation matches."
        },
        "entry_required": {
            "message": "Several Little Monkey installations: tell which one (config_entry_id)."
        },
        "data_not_read": {
            "message": "The data could not be read from ecojoko: {error}"
        },
        "equipment_not_found": {
            "message": "This device is not an equipment of a loaded Little Monkey installation."
        },
        "mode_not_supported": {
            "message": "ecojoko does not offer the mode {mode} for {name}."
        },
        "absence_end_required": {
            "message": "Give the duration or the end of the absence."
        },
        "duration_out_of_range": {
            "message": "The duration must be between {min} and {max} minutes."
        },
        "command_failed": {
            "message": "The command could not be sent to ecojoko: {error}. It may have been applied all the same."
        },
        "equipment_disabled": {
            "message": "Turn on the “Piloted equipments” option in the options of the Little Monkey integration."
        }
    }
}
